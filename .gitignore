# Generated by build_doc.py from the content in that script. Regenerate rather
# than editing, and note the print view inside the page is generated from the
# same source.
docs/*.pdf

# Generated by embed_db.py — rebuild with `python3 embed_db.py`.
# Deliberately not committed: ~1.3 MB of base64 that changes wholesale on every
# rebuild, so committing it would balloon history. CI builds it instead.
dcr-calculator.html

# Local preview config; contains machine-specific absolute paths.
.claude/

# Source workbooks and geodatabases are client data. Never commit them.
# data/ was tracked once by accident and reached the public remote; history
# has been rewritten to drop it, and verify_build.py now fails if it returns.
sources/
data/
*.xls
*.xlsx
*.pdf
*.gdb/

# Python / OS noise
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
# Editor swap/backup files
*.swp
*.swo
*~
